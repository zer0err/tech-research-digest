        "items": [
          {
            "uid": "f55febd0238ec8ccfed864d7",
            "title": "Securing Autonomous Multi-Agent AI Systems: A Zero-Trust Framework for Threat Detection, Behavioral Monitoring, and Resilience in Enterprise Environments",
            "url": "https://doi.org/10.32628/ijsrst2613620",
            "published": "2026-11-15T00:00:00+00:00",
            "summary": "This is an important issue in developing multi-agent systems in the context of distributed, autonomous, large-language models. Large-language model (LLM) agents delegate tasks, call tools and act on real-world agents. Generally, the most dangerous inputs arrived as natural-language messages from trusted peers, and one compromised agent could pass along its nefarious instructions to others. This paper proposes ZT-MAS, which brings together cryptographic agent identity and attestation, intent-bound capability tokens on every request, provenance tagging for taint propagation, a behavioural trust score that combines policy, sequence, provenance and drifting with taint propagation, a graduated response layer with step-up approval, restriction, quarantine and rollback, and a graduate response layer with step-down approval, restriction, quarantine and rollback. The framework is based on NIST SP 800-207, OWASP Top 10 for Agentic Applications, and MAESTRO threat model. We simulate an eight-agent enterprise workflow and sampled simulated a simulated a seeded simulation of a small company to determine the level of trust associated with goal hijacking, confused-deputy privilege escalation, prompt infection, memory poisoning, memory poisoning, and data exfiltration (500 episodes per cell). The perimeter zero-trust failed in all but behavioural tracking alone stopped every episode of a confu",
            "source": "Crossref Inference",
            "kind": "research",
            "doi": "10.32628/ijsrst2613620",
            "date_precision": "day",
            "aliases": [
              "doi:10.32628/ijsrst2613620",
              "url:https://doi.org/10.32628/ijsrst2613620"
            ]
          },
          {
            "uid": "75ec3361be4baf3a7a9efbc7",
            "title": "When One GPU Isn’t Enough: Serving GLM-5.3 Across Two NVIDIA DGX Stations with vLLM",
            "url": "https://developer.nvidia.com/blog/when-one-gpu-isnt-enough-serving-glm-5-3-across-two-nvidia-dgx-stations-with-vllm",
            "published": "2026-11-13T17:00:00+00:00",
            "summary": "Running a frontier-scale model locally means keeping all its weights in GPU memory; the largest models no longer fit on one machine. Two NVIDIA DGX Stations...",
            "source": "NVIDIA Technical Blog",
            "kind": "research",
            "doi": "",
            "date_precision": "day",
            "aliases": [
              "url:https://developer.nvidia.com/blog/when-one-gpu-isnt-enough-serving-glm-5-3-across-two-nvidia-dgx-stations-with-vllm"
            ]
